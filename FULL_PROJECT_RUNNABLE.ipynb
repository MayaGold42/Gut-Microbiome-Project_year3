    "\n",
    "mapping_summary = (\n",
    "    dietary_consumption_matrix\n",
    "    .groupby([\"diet_l1_category\", \"cfmd_category\", \"fme_weight\"])\n",
    "    .size()\n",
    "    .reset_index(name=\"n_food_items\")\n",
    "    .sort_values(\"n_food_items\", ascending=False)\n",
