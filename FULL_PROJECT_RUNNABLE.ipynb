    "    (\"daily_nutrition_totals\",     daily_nutrition_totals),\n",
    "    (\"cfmd_food_abundance\",        cfmd_food_abundance),\n",
    "    (\"cfmd_food_metadata\",         cfmd_food_metadata),\n",
    "]:\n",
    "    print(f\"  {name:<32} {str(df.shape)}\")\n"
   ]
  },
