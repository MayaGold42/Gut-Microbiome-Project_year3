   "source": [
    "fme = fme.sort_values([\"participant_id\", \"study_day\"])\n",
    "\n",
    "fme[\"fme_3days_avg\"] = (\n",
    "    fme.groupby(\"participant_id\")[\"fme_score_daily\"]\n",
    "       .transform(lambda x: x.rolling(3, min_periods=1).mean())\n",
    ")\n",
    "\n",
    "fme[\"fme_5days_avg\"] = (\n",
    "    fme.groupby(\"participant_id\")[\"fme_score_daily\"]\n",
    "       .transform(lambda x: x.rolling(5, min_periods=1).mean())\n",
    ")\n",
    "\n",
    "fme[\n",
    "    [\"participant_id\",\n",
    "     \"study_day\",\n",
    "     \"fme_score_daily\",\n",
    "     \"fme_3days_avg\",\n",
    "     \"fme_5days_avg\"]\n",
    "].head()"
