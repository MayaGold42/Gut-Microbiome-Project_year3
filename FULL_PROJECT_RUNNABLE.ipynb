    "# Sparsity and Prevalence Analysis of the Paper 2 Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ca994289",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total values in dataset: 17158401\n",
      "Number of zero values: 17063753\n",
      "Sparsity: 99.45%\n"
     ]
    }
   ],
   "source": [
    "# Calculate sparsity\n",
    "\n",
    "total_values = combined.size\n",
    "zero_values = (combined == 0).sum().sum()\n",
    "\n",
    "sparsity = (zero_values / total_values) * 100\n",
    "\n",
    "print(\"Total values in dataset:\", total_values)\n",
    "print(\"Number of zero values:\", zero_values)\n",
    "print(f\"Sparsity: {sparsity:.2f}%\")"
   ]
